# Local preparation: explicitly opt into volatile storage; real email is disabled.
API_STORAGE=memory
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8080
FRONTEND_ORIGIN=http://127.0.0.1:3101

# Deployment: API_STORAGE=postgres, NODE_ENV=production, HTTPS frontend origin.
DATABASE_URL=
RESEND_API_KEY=
RESEND_FROM=
NOTIFICATIONS_DELIVERY_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
POLL_INTERVAL_SECONDS=30
# No wallet private key, cranker key, or JWT signing secret is used by this slice.
